<?xml version="1.0" encoding="EUC-KR"?>
<rMateMapChart>
	<MapChart id="mainMap" showDataTips="true" paddingLeft="0" paddingRight="0" paddingTop="0" paddingBottom="0"
				gutterLeft="50" gutterRight="50" gutterTop="50" gutterBottom="50" dataTipJsFunction="dataTipFunction" dataTipMode="single" showDataTipTargets="false" maximumDataTipCount="0" itemClickJsFunction="itemClickFunction">
		<series>
			<MapSeries id="mapseries" interactive="true" selectionMarking="line" color="0x777777"
				labelPosition="inside" displayName="Map" >
				<filters>
					<DropShadowFilter distance="2" angle="45" color="0x888888"/>
				</filters>
				<localFill>
<!--
alpha 투명도 (기본 1)
color 색상
-->
					<SolidColor color="0x72BFD5"/>
				</localFill>
				<showDataEffect>
					<SeriesInterpolate duration="1000"/>
				</showDataEffect>
				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
<!--
adjustedRadius 사용자가 선택하거나 롤오버시 지점 마크의 크기 증가 픽셀수 (기본 2)
alpha 투명도 (기본 1)
areaCodeField dataProvider에서 지역 코드를 나타내는 필드명 (기본 code)
fill 표시할 색상
fillJsFunction 자바스크립트를 이용한 표시마크의 색상 변경기능 (자바스크립트에서 선언한 함수명을 넣어줍니다)
filters 시리즈에 적용할 필터
hideDataEffect 지점이 사라질때 적용할 이펙트
horizontalCenterGapField 지점 수평 이동좌표를 지정하는 data provider의 필드명
imageWidth 표시될 이미지의 넓이 - 지정하지 않으면 원본 이미지 크기로 표시됩니다
imageHeight 표시될 이미지의 높이 - 지정하지 않으면 원본 이미지 크기로 표시됩니다
imageUrlField dataProvider에서 지역별 이미지 URL 값을 나타내는 필드명
interactive 사용자 마우스 조작에 반응할지 여부 (true,false중 택일, 기본 true)
labelFilters 라벨에 적용할 필터
labelField 라벨을 지정하는 data provider의 필드명
labelJsFunction 자바스크립트를 이용한 라벨 변경기능 (자바스크립트에서 선언한 함수명을 넣어줍니다)
labelPosition 라벨의 위치를 설정  (none, top, bottom, left, right중 택일, 기본 none)
labelPositionField 라벨 위치를 지정하는 data provider의 필드명
showDataEffect 지점이 표시될때 적용할 이펙트
stroke 표시할 경계 라인 색상
useHandCursor 시리즈에 마우스가 올 경우 커서를 손모양으로 바꿀지 여부 (true,false중 택일, 기본 false)
useRevisedCenter mapDataBased에 설정된 중심 이동 값의 적용여부 (true,false중 택일, 기본 true)
verticalCenterGapField 지점 수직 이동좌표를 지정하는 data provider의 필드명
-->

			<MapImageSeries id="mapserise" labelField="blank" imageUrlField="imgurl" horizontalCenterGapField="h" verticalCenterGapField="v"
				color="0xffffffff" labelPosition="bottom" displayName="영업정보" useHandCursor="true" interactive="true">
				<labelFilters>
					<GlowFilter blurX="5" blurY="5" color="0x111111"/>
				</labelFilters>
				<showDataEffect>
					<SeriesSlide duration="1000"/>
				</showDataEffect>
				<stroke>
					<Stroke color="0xFFFFFF" alpha="0" /> 
				</stroke>
				<fill>
					<SolidColor color="0xFFFFFF" alpha="0" /> 
				</fill>
			</MapImageSeries>

			<!--
			<MapPanelSeries id="panel" titleField="country" bodyTextField="tCount" horizontalCenterGapField="h" verticalCenterGapField="v"
				color="0x555555" horizontalAlign="right" displayName="영업정보">
				<showDataEffect>
					<SeriesSlide duration="1000"/>
				</showDataEffect>
			</MapPanelSeries>
			-->


		</series>
		<backgroundElements>
<!--
	Image의 속성으로는
	source 실제 이미지가 있는 URL경로입니다
	maintainAspectRation 이미지 원본 비율을 유지할지를 나타냅니다
							true면 고유비율을 유지하려 하고
							false면 차트 크기에 맞춘 사이즈를 갖습니다
	alpha 이미지의 투명도를 나타냅니다
	horizontalAlign 수펑 정렬 (left,right,center중 택일, 기본 left)
	verticalAlign 수직 정렬 (top,middle,bottom중 택일, 기본 top)
	smoothBitmapContent 이미지를 부드럽게 바꿀지 여부 (true,false중 택일, 기본 false)
-->
			<Image source="/gm/images/map_bg.jpg" maintainAspectRatio="true" alpha="1" smoothBitmapContent="true" horizontalAlign="center" verticalAlign="middle"/>
		</backgroundElements>

	</MapChart>
</rMateMapChart>