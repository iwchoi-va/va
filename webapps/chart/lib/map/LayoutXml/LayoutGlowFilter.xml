<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
	<MapChart id="mainMap" gutterBottom="10">
		<series>
			<MapSeries id="mapseries">
				<filters>
<!--
alpha 투명도 (기본 1)
blurX 0에서 255까지의 수평 번짐 정도 (기본값 4)
blurY 0에서 255까지의 수직 번짐 정도 (기본값 4)
color 색상
inner 안으로 그림자를 줄지 여부 (true,false중 택일, 기본 false)
strength 0에서 255까지의 퍼짐 정도 (기본값 1)
-->
					<GlowFilter blurX="50" blurY="50" color="#C73399"/>
				</filters>
				<showDataEffect>
					<SeriesInterpolate duration="1000"/>
				</showDataEffect>
				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
		</series>
	</MapChart>
</rMateMapChart>