<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
	<MapChart id="mainMap">
		<series>
			<MapSeries id="mapseries" enabledField="enabled">
				<filters>
					<DropShadowFilter distance="2" angle="45" color="0x888888"/>
				</filters>
				<showDataEffect>
					<SeriesInterpolate duration="1000"/>
				</showDataEffect>
<!--
disabled된 이미지를 표현하는 색상을 disabledFill, disabledStroke에 넣어줍니다
-->
				<disabledFill>
					<LinearGradient angle="-45">
						<entries>
							<GradientEntry color="0xEEEEEE" ratio="0.0"/>
							<GradientEntry color="0xAAAAAA"/>
						</entries>
					</LinearGradient>
				</disabledFill>
				<disabledStroke>
					<Stroke color="0x444444" weight="0.25" alpha="0.25"/>
				</disabledStroke>

				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
		</series>
	</MapChart>
</rMateMapChart>