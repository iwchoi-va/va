<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
	<MapChart id="mainMap" showDataTips="true" gutterBottom="10">
		<series>
			<MapSeries id="mapseries" interactive="false" displayName="Map">
				<filters>
					<DropShadowFilter distance="2" angle="45" color="0x888888"/>
				</filters>
				<showDataEffect>
					<SeriesInterpolate duration="1000"/> 
				</showDataEffect>
				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
<!--
Series의 areaCodeField 속성을 이용하여 데이타안에서 해당 Series의 데이타를 찾아가도록 합니다.
areaCodeField dataProvider에서 지역 코드를 나타내는 필드명 (기본 code)
-->
			<MapBubbleSeries id="series1" areaCodeField="codeA" radiusField="sales" fill="#00ff33" minRadius="5" color="0x888888" itemRenderer="BallItemRenderer">
				<showDataEffect>
					<SeriesSlide duration="1000" direction="right"/>
				</showDataEffect>
				<stroke>
					<Stroke color="#00ff33" weight="0.25" alpha="0.5"/>
				</stroke>
			</MapBubbleSeries>
			<MapBubbleSeries id="series2" areaCodeField="codeB" radiusField="sales" fill="#66ccFF" minRadius="5" color="0x888888" itemRenderer="BallItemRenderer">
				<showDataEffect>
					<SeriesSlide duration="1000" direction="left"/>
				</showDataEffect>
				<stroke>
					<Stroke color="#FFcc66" weight="0.25" alpha="0.5"/>
				</stroke>
			</MapBubbleSeries>
		</series>
	</MapChart>
</rMateMapChart>