<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
	<MapChart id="mainMap">
		<series>
			<MapSeries id="mapseries">
				<filters>
					<DropShadowFilter distance="2" angle="45" color="0x888888"/>
				</filters>
				<localFill>
<!--
alpha 투명도 (기본 1)
color 색상
-->
					<SolidColor color="0xF3C849"/>
				</localFill>
				<showDataEffect>
					<SeriesInterpolate duration="1000"/>
				</showDataEffect>
				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
		</series>
	</MapChart>
</rMateMapChart>