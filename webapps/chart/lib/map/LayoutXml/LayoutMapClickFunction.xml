<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
<!--
mapChangeJsFunction 맵클릭시 불러질 자바스크립트연동 기능 (자바스크립트에서 선언한 함수명을 넣어줍니다)
-->
	<MapChart id="mainMap" drillDownEnabled="false" showDataTips="true" mapChangeJsFunction="clickFunction">
		<series>
			<MapSeries id="mapseries" selectionMarking="line" labelPosition="inside" displayName="전국">
				<showDataEffect>
					<SeriesSlide duration="1000" direction="right"/>
				</showDataEffect>
				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
		</series>
	</MapChart>
</rMateMapChart>
