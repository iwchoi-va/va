<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
	<MapChart id="mainMap" drillDownEnabled="false">
		<series>
			<MapSeries id="mapseries">
				<filters>
					<DropShadowFilter distance="2" angle="45" color="0x888888"/>
				</filters>
				<showDataEffect>
					<SeriesInterpolate duration="1000"/> 
				</showDataEffect>
<!--
선택된 이미지를 표현하는 색상을 selectionFill, selectionStroke에 넣어줍니다
-->
				<selectionFill>
					<LinearGradient angle="-45">
						<entries>
							<GradientEntry color="0xF3D3DB" ratio="0.0"/>
							<GradientEntry color="0xB15C9B" ratio="0.5"/>
							<GradientEntry color="0x6B6BB1"/>
						</entries>
					</LinearGradient>
				</selectionFill>
				<selectionStroke>
					<Stroke color="0x444444" weight="0.25" alpha="0.25"/>
				</selectionStroke>

				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
		</series>
	</MapChart>
</rMateMapChart>