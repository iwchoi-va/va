<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
	<MapChart id="mainMap" drillDownEnabled="false" showDataTips="true" gutterTop="15" gutterBottom="15">
		<series>
			<MapSeries id="mapseries" interactive="false">
				<filters>
					<DropShadowFilter distance="2" angle="45" color="0x888888"/>
				</filters>
				<showDataEffect>
					<SeriesInterpolate duration="1000"/>
				</showDataEffect>
				<localFill>
					<SolidColor color="0xEEEEEE"/>
				</localFill>
				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
<!--
adjustedRadius 사용자가 선택하거나 롤오버시 지점 마크의 크기 증가 픽셀수 (기본 0)
alpha 투명도 (기본 1)
areaCodeField dataProvider에서 지역 코드를 나타내는 필드명 (기본 code)
backgroundFill 판넬의 배경 색상 (기본 흰색)
bodyTextField dataProvider에서 판넬의 내용을 나타내는 필드명
cornerRadius 판넬의 모서리 반지름 (기본 4)
fill 표시할 색상
fillJsFunction 자바스크립트를 이용한 표시마크의 색상 변경기능 (자바스크립트에서 선언한 함수명을 넣어줍니다)
filters 시리즈에 적용할 필터
headerHeight 판넬의 헤더 높이 - itemRederer를 VPanelItemRenderer를 사용할 경우 지정할 수 있습니다.
headerWidth 판넬의 헤더 넓이 - itemRederer를 HPanelItemRenderer를 사용할 경우 지정할 수 있습니다.
hideDataEffect 지점이 사라질때 적용할 이펙트
horizontalAlign 판넬 바디의 수펑 정렬 (left,right,center중 택일, 기본 left)
horizontalCenterGapField 지점 수평 이동좌표를 지정하는 data provider의 필드명
itemRenderer 판넬을 그리는 객체 (VPanelItemRenderer, HPanelItemRenderer등이 있습니다)
interactive 사용자 마우스 조작에 반응할지 여부 (true,false중 택일, 기본 true)
paddingLeft 왼쪽 끝과 컨텐츠 영역 왼쪽 사이의 픽셀 수 (기본 5)
paddingRight 오른쪽 끝과 컨텐츠 영역 오른쪽 사이의 픽셀 수 (기본 5)
paddingTop 윗쪽 끝과 컨텐츠 영역 윗쪽 사이의 픽셀 수 (기본 3)
paddingBottom 아랫쪽 끝과 컨텐츠 영역 아랫쪽 사이의 픽셀 수 (기본 3)
panelWidth 표시될 이미지의 넓이 - 지정하지 않으면 원본 이미지 크기로 표시됩니다
panelHeight 표시될 이미지의 높이 - 지정하지 않으면 원본 이미지 크기로 표시됩니다
showDataEffect 지점이 표시될때 적용할 이펙트
showHeader 헤더를 표시할지 여부 (true,false중 택일, 기본 true)
stroke 표시할 경계 라인 색상
titleField 판넬 제목을 지정하는 data provider의 필드명
titleJsFunction 자바스크립트를 이용한 판넬 제목 변경기능 (자바스크립트에서 선언한 함수명을 넣어줍니다)
titleStyleName 판넬 타이틀의 스타일명
useHandCursor 시리즈에 마우스가 올 경우 커서를 손모양으로 바꿀지 여부 (true,false중 택일, 기본 false)
useRevisedCenter mapDataBased에 설정된 중심 이동 값의 적용여부 (true,false중 택일, 기본 true)
verticalAlign 판넬 바디의 수직 정렬 (top,middle,bottom중 택일, 기본 top)
verticalCenterGapField 지점 수평 이동좌표를 지정하는 data provider의 필드명
wordWrap 판넬 바디 문자열의 자동 줄바꿈 여부 (true,false중 택일, 기본 false)
-->
			<MapPanelSeries id="panel" titleJsFunction="titleFunction" bodyTextField="temperature" horizontalCenterGapField="h" verticalCenterGapField="v"
				color="0x555555" horizontalAlign="right" displayName="날씨">
				<showDataEffect>
					<SeriesSlide duration="1000"/>
				</showDataEffect>
			</MapPanelSeries>
		</series>
	</MapChart>
</rMateMapChart>