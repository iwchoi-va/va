<?xml version="1.0" encoding="utf-8"?>
<rMateMapChart>
	<MapChart id="mainMap" drillDownEnabled="true" showDataTips="true">
		<series>
			<MapSeries id="mapseries" displayName="Map Series">
				<filters>
					<DropShadowFilter distance="2" angle="45" color="0x888888"/>
				</filters>
				<showDataEffect>
<!--
direction 이펙트 방향 (left, right, up, down중 택일, 기본 left)
duration 이펙트 시간(단위 밀리세컨드)
elementOffset 개별 지역 이미지의 이펙트 시작 간격(단위 밀리세컨드)(기본 20)
startDelay 이펙트가 시작되기 전 간격(단위 밀리세컨드)(기본 0)
-->
					<SeriesSlide duration="1500" direction="up"/>
				</showDataEffect>
				<stroke>
					<Stroke color="0xe1e1e1" weight="0.8" alpha="1"/>
				</stroke>
			</MapSeries>
		</series>
	</MapChart>
</rMateMapChart>