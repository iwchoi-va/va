<?xml version="1.0" encoding="UTF-8"?>
<DomainConfig>
    <DataSourcePool>
		<MailDataSource 
			Id="smtpdatasource"
			User="user@gmail.com"
			Password="{DES}password"
		>
			<Property Name="mail.transport.protocol" Value="smtp"/>
			<Property Name="mail.smtp.host" Value="smtp.gmail.com"/>
			<Property Name="mail.smtp.port" Value="465"/>
			<Property Name="mail.smtp.socketFactory.port" Value="465"/>
			<Property Name="mail.smtp.socketFactory.class" Value="javax.net.ssl.SSLSocketFactory"/>
			<Property Name="mail.smtp.socketFactory.fallback" Value="false"/>
		</MailDataSource>		
	</DataSourcePool>
	
    <ServiceDefinition>	
		<Service Id="restart_notice_service">
			<Description>XCron 강제종료 후 실행되는 서비스</Description>
			<RequestFlow><RequestGroup Value="log.send_restart_mail"/></RequestFlow>
		</Service>
		
		<Service Id="empty_notice_service">
			<Description>Empty Notice</Description>
		</Service>
    </ServiceDefinition>

    <RequestServiceDefinition>		
		<RequestService Id="log.send_restart_mail" DataSource="smtpdatasource">
			<BatchName>_SHUTDOWNLOG</BatchName>
			<Envelope>
				<MailFrom><![CDATA[
서동욱 <dwseo@hansol.com>
				]]></MailFrom>
				<MailTo><![CDATA[
ISForceLite30 <isforcelite30@gmail.com>
				]]></MailTo>
				<MailCc><![CDATA[
				]]></MailCc>				
				<MailTitle><![CDATA[
[사이트명] XCron 서버에 장애가 발생했습니다.
				]]></MailTitle>
				<MailBody><![CDATA[ 
